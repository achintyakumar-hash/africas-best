  endcase
-%}

{%- if path -%}
  <svg
    class="ab-icon ab-icon--{{ name }}{% if class %} {{ class }}{% endif %}"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path d="{{ path }}"/>
  </svg>
{%- endif -%}
