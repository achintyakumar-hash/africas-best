{%- comment -%}
  Inline SVG icon set (Material-style, 24px grid). Icons are decorative by default:
  give the parent control an accessible name.

  Accepts:
  - name {String}: menu | close | search | chevron-down | chevron-left | chevron-right | add |
    remove | arrow-forward | star | play | pause | store | tune | check | facebook | instagram | tiktok
  - size {Number}: rendered size in px (default 24)
  - class {String}: extra classes

  Usage:
  {% render 'ab-icon', name: 'search', size: 26 %}
{%- endcomment -%}

{%- liquid
  assign icon_size = size | default: 24
  case name
    when 'menu'
      assign path = 'M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z'
    when 'close'
      assign path = 'M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z'
    when 'search'
      assign path = 'M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z'
    when 'chevron-down'
      assign path = 'M16.59 8.59 12 13.17 7.41 8.59 6 10l6 6 6-6z'
    when 'chevron-left'
      assign path = 'M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z'
    when 'chevron-right'
      assign path = 'M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z'
    when 'add'
      assign path = 'M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z'
    when 'remove'
