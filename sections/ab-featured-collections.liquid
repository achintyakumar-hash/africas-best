{%- comment -%}
  Featured Collections (FINAL / Homepage section 4).
  Desktop: 4 tiles in a row. Each has a 320px sage panel (12px radius) with 3 products standing
  on a soft shadow, then the name, a 2-line description and a VIEW → link.
  Tablet: 4 in a row. Mobile: 2 x 2 grid of 169px square panels, products max 120px tall.
  Each tile shows its collection's first 3 product photos, or the optional image override.
  An empty collection picker falls back to the collections growth-oils, olive-oil-conditioning,
  repair-restore and kids (by position), then to all products.
{%- endcomment -%}

{{ 'ab-featured-collections.css' | asset_url | stylesheet_tag: preload: true }}

{%- assign fallback_handles = 'growth-oils,olive-oil-conditioning,repair-restore,kids' | split: ',' -%}

<section class="ab-scope ab-collections ab-section ab-bg--{{ section.settings.background }}">
  <div class="ab-container">
    {%- if section.settings.heading != blank -%}
      <div class="ab-section-header ab-section-header--center">
        <h2 class="ab-section-heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <ul class="ab-collections__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_collection = block.settings.collection
          if tile_collection == blank
            assign fallback_handle = fallback_handles[forloop.index0]
            if fallback_handle
              assign tile_collection = collections[fallback_handle]
            endif
          endif
          assign tile_title = block.settings.title | default: tile_collection.title
          assign tile_description = block.settings.description | default: tile_collection.description | strip_html | truncate: 90
          assign tile_url = tile_collection.url | default: '/collections/all'
          assign tile_products = tile_collection.products
          if tile_products == blank or tile_products.size == 0
            assign tile_products = collections.all.products
          endif
        -%}
        <li class="ab-collections__item" {{ block.shopify_attributes }}>
          <a href="{{ tile_url }}" class="ab-collections__panel" tabindex="-1" aria-hidden="true">
            <span class="ab-collections__shadow"></span>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 640
                | image_tag:
                  class: 'ab-collections__override',
                  widths: '240, 320, 480, 640',
                  sizes: '(min-width: 1024px) 300px, (min-width: 768px) 25vw, 169px',
                  loading: 'lazy',
                  alt: ''
              }}
            {%- else -%}
              {%- for product in tile_products limit: 3 -%}
                {%- if product.featured_media -%}
                  {{
                    product.featured_media.preview_image
                    | image_url: width: 300
                    | image_tag:
                      class: 'ab-collections__product',
                      widths: '120, 200, 300',
                      sizes: '(min-width: 1024px) 100px, 60px',
                      loading: 'lazy',
                      alt: ''
                  }}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </a>
          <div class="ab-collections__body">
            <h3 class="ab-collections__name">{{ tile_title | default: 'Collection' }}</h3>
            {%- if tile_description != blank -%}
              <p class="ab-collections__description">{{ tile_description }}</p>
            {%- endif -%}
            {%- render 'ab-button',
              label: block.settings.link_label,
              url: tile_url,
              style: 'link',
              icon_after: 'arrow-forward',
              visually_hidden_suffix: tile_title,
              class: 'ab-collections__link'
            -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "AB: Featured collections",
  "tag": "div",
  "class": "ab-collections-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collections"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Leave empty to use growth-oils, olive-oil-conditioning, repair-restore and kids for tiles 1-4. The tile shows the collection's first 3 product photos."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "info": "Defaults to the collection's title."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "info": "Shown on 2 lines. Defaults to the collection's description."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Optional product group shot on a transparent or sage background. Replaces the 3 product photos."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "View"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB: Featured collections",
      "blocks": [
        { "type": "collection", "settings": { "title": "Growth Oils", "description": "Lightweight oils that nourish the scalp and support length retention." } },
        { "type": "collection", "settings": { "title": "Olive Oil Conditioning", "description": "Rich, olive-powered moisture for soft, manageable hair." } },
        { "type": "collection", "settings": { "title": "Repair & Restore", "description": "Strengthening care that revives dry, damaged and brittle strands." } },
        { "type": "collection", "settings": { "title": "Kids", "description": "Gentle, tear-free formulas made for little curls and coils." } }
      ]
    }
  ]
}
{% endschema %}
