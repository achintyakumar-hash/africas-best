{%- comment -%}
  Collection banner (FINAL / Collection Page, lifestyle banner).
  Desktop (1024px+): 420px full-bleed photo; a white title block (640px, 12px radius, 48px
  padding) overlaps its bottom-left by 140px, with the H1 (collection title) and description.
  Mobile/tablet: rounded photo inside the side padding (280px / 360px tall), then the H1 and
  description below it.
  Content comes from the collection (title, description, image); section settings override it.
  Without any image the photo area shows the neutral placeholder colour.
{%- endcomment -%}

{{ 'ab-collection-banner.css' | asset_url | stylesheet_tag: preload: true }}

{%- liquid
  assign banner_title = section.settings.heading | default: collection.title | default: 'Collection'
  assign banner_image = section.settings.image | default: collection.image
  assign banner_position = banner_image.presentation.focal_point | default: 'center 40%'
  if section.settings.text != blank
    assign banner_text = section.settings.text
  else
    assign banner_text = collection.description
  endif
-%}

<section class="ab-scope ab-collection-banner ab-bg--{{ section.settings.background }}">
  <div class="ab-collection-banner__media" style="--ab-banner-position: {{ banner_position }};">
    {%- if banner_image != blank -%}
      {%- render 'ab-image',
        image: banner_image,
        alt: '',
        widths: '400, 600, 800, 1200, 1600, 2000, 2400',
        sizes: '(min-width: 1024px) 100vw, calc(100vw - 40px)',
        class: 'ab-collection-banner__image',
        eager: true
      -%}
    {%- else -%}
      <span class="ab-placeholder ab-collection-banner__image" aria-hidden="true"></span>
    {%- endif -%}
  </div>

  <div class="ab-container ab-collection-banner__container">
    <div class="ab-collection-banner__card">
      <h1 class="ab-collection-banner__title">{{ banner_title }}</h1>
      {%- if banner_text != blank -%}
        <div class="ab-collection-banner__text ab-rte">{{ banner_text }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AB: Collection banner",
  "tag": "div",
  "class": "ab-collection-banner-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the collection's title, description and image (set them in Products > Collections). The settings below override them for this template."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image override",
      "info": "Landscape, at least 2400 x 840px. Leave empty to use the collection image. Without either, a neutral placeholder is shown."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave empty to use the collection title."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description override",
      "info": "Leave empty to use the collection description."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "info": "Behind the title block where it extends below the photo (desktop).",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" }
      ],
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "AB: Collection banner"
    }
  ]
}
{% endschema %}
