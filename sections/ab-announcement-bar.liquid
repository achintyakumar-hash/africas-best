{%- comment -%}
  Announcement bar. Thin bar above the header, dismissible.
  Desktop: 40px tall, 13px Medium, centered, close X 24px from the right.
  Mobile: 12px text wrapping to 2 lines, 20px left padding, 44px close target.
  Dismissal is remembered per message: changing the text shows the bar again.
{%- endcomment -%}

{%- liquid
  assign announcement_key = section.settings.text | append: section.settings.link | md5
-%}

{%- if section.settings.text != blank -%}
  <div
    class="ab-scope ab-announcement ab-on-dark"
    style="--ab-announcement-bg: {{ section.settings.background }}; --ab-announcement-fg: {{ section.settings.text_color }};"
    data-ab-announcement
    data-key="{{ announcement_key }}"
    role="region"
    aria-label="Announcement"
  >
    <p class="ab-announcement__text">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="ab-announcement__link">{{ section.settings.text }}</a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </p>
    {%- if section.settings.dismissible -%}
      <button type="button" class="ab-icon-btn ab-announcement__close" data-ab-announcement-close aria-label="Close announcement">
        {%- render 'ab-icon', name: 'close', size: 18 -%}
      </button>
    {%- endif -%}
  </div>
  {%- if section.settings.dismissible -%}
    <script>
      (function () {
        try {
          var bar = document.currentScript.previousElementSibling;
          if (localStorage.getItem('ab-announcement-dismissed') === bar.dataset.key && !window.Shopify?.designMode) {
            bar.hidden = true;
          }
        } catch (error) {}
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "AB: Announcement bar",
  "tag": "div",
  "class": "ab-announcement-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Now one brand: Africa's Best. Find your favorites at Walmart, Target and your local beauty supply store."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional. Makes the whole message a link."
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Show close button",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#123D2E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "info": "Keep at least 4.5:1 contrast with the background.",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "AB: Announcement bar"
    }
  ]
}
{% endschema %}
