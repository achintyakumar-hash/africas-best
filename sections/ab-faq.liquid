{%- comment -%}
  FAQ accordion. Reused on the collection page, product page and blog article.
  Desktop: centered 800px column, 40px heading, 17px questions with 24px row padding.
  Mobile: full width inside 20px padding, 26px heading, 56px minimum rows.
  Uses native <details>/<summary>, so it works from the keyboard without JavaScript.
{%- endcomment -%}

{{ 'ab-faq.css' | asset_url | stylesheet_tag: preload: true }}

{%- liquid
  assign faq_heading_id = 'AbFaqHeading-' | append: section.id

  comment
    Optional per-collection/product FAQ from a metafield: custom.faq, a list of metaobjects with
    a "question" (single line text) and an "answer" (rich text or multi-line text) field.
    Falls back to the section's own question blocks.
  endcomment
  assign faq_entries = blank
  if section.settings.use_metafield
    if collection
      assign faq_entries = collection.metafields.custom.faq.value
    elsif product
      assign faq_entries = product.metafields.custom.faq.value
    endif
  endif
  assign use_entries = false
  if faq_entries != blank and faq_entries.size > 0
    assign use_entries = true
  endif
-%}

{%- capture faq_items -%}
  {%- if use_entries -%}
    {%- for entry in faq_entries -%}
      <details
        class="ab-accordion__item"
        {% if forloop.first and section.settings.open_first %}
          open
        {% endif %}
      >
        <summary class="ab-accordion__summary">
          <span>{{ entry.question.value }}</span>
          <span class="ab-accordion__icon">
            {%- render 'ab-icon', name: 'add' -%}
            {%- render 'ab-icon', name: 'remove' -%}
          </span>
        </summary>
        <div class="ab-accordion__content ab-rte">
          {%- if entry.answer.type == 'rich_text_field' -%}
            {{ entry.answer | metafield_tag }}
          {%- else -%}
            <p>{{ entry.answer.value | newline_to_br }}</p>
          {%- endif -%}
        </div>
      </details>
    {%- endfor -%}
  {%- else -%}
    {%- for block in section.blocks -%}
      <details
        class="ab-accordion__item"
        {% if forloop.first and section.settings.open_first %}
          open
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <summary class="ab-accordion__summary">
          <span>{{ block.settings.question }}</span>
          <span class="ab-accordion__icon">
            {%- render 'ab-icon', name: 'add' -%}
            {%- render 'ab-icon', name: 'remove' -%}
          </span>
        </summary>
        <div class="ab-accordion__content ab-rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if faq_items != blank -%}
  <section
    class="ab-scope ab-faq ab-section ab-bg--{{ section.settings.background }}"
    {% if section.settings.heading != blank %}
      aria-labelledby="{{ faq_heading_id }}"
    {% endif %}
  >
    <div class="ab-container ab-container--narrow">
      {%- if section.settings.heading != blank -%}
        <h2 id="{{ faq_heading_id }}" class="ab-section-heading ab-section-heading--center ab-faq__heading">
          {{- section.settings.heading -}}
        </h2>
      {%- endif -%}

      <div class="ab-accordion">{{ faq_items }}</div>
    </div>

    {%- if section.settings.structured_data -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- if use_entries -%}
              {%- for entry in faq_entries -%}
                {
                  "@type": "Question",
                  "name": {{ entry.question.value | strip_html | json }},
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": {{ entry.answer | metafield_text | json }}
                  }
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            {%- else -%}
              {%- for block in section.blocks -%}
                {
                  "@type": "Question",
                  "name": {{ block.settings.question | strip_html | json }},
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": {{ block.settings.answer | strip_html | json }}
                  }
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            {%- endif -%}
          ]
        }
      </script>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "AB: FAQ",
  "tag": "div",
  "class": "ab-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "info": "Alternate white and cream so neighbouring sections differ.",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "white"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_metafield",
      "label": "Use the page's own FAQ when it has one",
      "info": "On collection and product pages, shows the FAQ from the custom.faq metafield (a list of FAQ entries with question and answer). Otherwise the questions below are shown.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "Add FAQ structured data for search engines",
      "info": "Use on one FAQ per page only.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Which growth oil is right for my hair?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>For daily shine and softness, try Argan Growth Oil. For dry, brittle hair, choose Black Castor Growth Oil or Super Gro Max.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB: FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Which growth oil is right for my hair?",
            "answer": "<p>For daily shine and softness, try Argan Growth Oil. For dry, brittle hair, choose Black Castor Growth Oil or Super Gro Max.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How often should I use a growth oil?",
            "answer": "<p>Most growth oils can be used 3 to 4 times a week, or daily on dry areas and ends.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I use these oils on my scalp?",
            "answer": "<p>Yes. Part your hair and massage a small amount directly into the scalp.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Are these products safe for color-treated hair?",
            "answer": "<p>Our growth oils are gentle and suitable for color-treated hair.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I use growth oils on protective styles?",
            "answer": "<p>Yes. Apply to the scalp between braids, twists or locs to keep it moisturized.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
