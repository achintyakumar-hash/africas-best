{%- comment -%}
  As Seen On You (FINAL / Homepage section 7). Also used on the collection page.
  Desktop: centered heading + subheading, 5 vertical 9:16 video cards in a row (arrows appear if
  there are more), each with a product tag card below.
  Mobile/tablet: swipe carousel of 180 x 320 cards with 180 x 48 product tags, dots below.
  Videos: muted, playsinline, loop, preload="none", poster image, never autoplay.
  The play button toggles playback.
  An empty product picker falls back to the best-sellers collection, then all products.
{%- endcomment -%}

{{ 'ab-ugc.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'ab-carousel.js' | asset_url }}" type="module"></script>
<script src="{{ 'ab-video-cards.js' | asset_url }}" type="module"></script>

{%- liquid
  assign tag_source = collections['best-sellers']
  if tag_source == blank or tag_source.products_count == 0
    assign tag_source = collections.all
  endif
-%}

<section class="ab-scope ab-ugc ab-section ab-bg--{{ section.settings.background }}">
  <div class="ab-container">
    <div class="ab-section-header ab-section-header--center">
      {%- if section.settings.heading != blank -%}
        <h2 class="ab-section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ab-section-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <ab-carousel class="ab-ugc__carousel" data-label="{{ section.settings.heading | escape }}">
      <ul class="ab-carousel__track" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag_product = block.settings.product
            if tag_product == blank
              assign tag_product = tag_source.products[forloop.index0]
            endif
            if tag_product == blank
              assign tag_product = collections.all.products[forloop.index0]
            endif

            assign mod = forloop.index0 | modulo: 4
            case mod
              when 0
                assign fallback_key = 'lifestyle-3'
                assign fallback_position = '30% center'
              when 1
                assign fallback_key = 'lifestyle-4'
                assign fallback_position = 'center'
              when 2
                assign fallback_key = 'lifestyle-1'
                assign fallback_position = '40% center'
              else
                assign fallback_key = 'lifestyle-2'
                assign fallback_position = '65% center'
            endcase
            capture fallback_url
              render 'ab-fallback-url', key: fallback_key
            endcapture
            assign poster = block.settings.poster | default: block.settings.video.preview_image
            assign poster_position = poster.presentation.focal_point | default: fallback_position
            assign card_label = block.settings.caption | default: tag_product.title
          -%}
          <li class="ab-carousel__slide ab-ugc__slide" {{ block.shopify_attributes }}>
            <div class="ab-ugc__media" style="--ab-ugc-position: {{ poster_position }};" data-ab-video-card>
              {%- if block.settings.video != blank -%}
                {%- if block.settings.poster != blank -%}
                  {%- assign poster_url = block.settings.poster | image_url: width: 540 -%}
                  {{
                    block.settings.video
                    | video_tag:
                      class: 'ab-ugc__video',
                      image_size: '540x',
                      poster: poster_url,
                      muted: true,
                      playsinline: true,
                      loop: true,
                      controls: false,
                      preload: 'none'
                  }}
                {%- else -%}
                  {{
                    block.settings.video
                    | video_tag:
                      class: 'ab-ugc__video',
                      image_size: '540x',
                      muted: true,
                      playsinline: true,
                      loop: true,
                      controls: false,
                      preload: 'none'
                  }}
                {%- endif -%}
                <button type="button" class="ab-ugc__play" data-ab-video-toggle aria-label="Play video{% if card_label != blank %}: {{ card_label | escape }}{% endif %}">
                  {%- render 'ab-icon', name: 'play', size: 22, class: 'ab-ugc__icon-play' -%}
                  {%- render 'ab-icon', name: 'pause', size: 22, class: 'ab-ugc__icon-pause' -%}
                </button>
              {%- else -%}
                {%- render 'ab-image',
                  image: poster,
                  fallback: fallback_url,
                  alt: block.settings.alt,
                  widths: '180, 270, 360, 540',
                  sizes: '(min-width: 1024px) 240px, 180px',
                  class: 'ab-ugc__poster',
                  width: 1024,
                  height: 1024
                -%}
              {%- endif -%}
            </div>

            {%- if tag_product != blank -%}
              <a href="{{ tag_product.url }}" class="ab-ugc__tag">
                <span class="ab-ugc__tag-thumb">
                  {%- if tag_product.featured_media -%}
                    {{
                      tag_product.featured_media.preview_image
                      | image_url: width: 96
                      | image_tag: widths: '48, 96', sizes: '40px', loading: 'lazy', alt: ''
                    }}
                  {%- endif -%}
                </span>
                <span class="ab-ugc__tag-name">{{ tag_product.title }}</span>
                <span class="ab-ugc__tag-arrow" aria-hidden="true">{% render 'ab-icon', name: 'arrow-forward', size: 18 %}</span>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- render 'ab-carousel-controls', label: 'videos' -%}
    </ab-carousel>
  </div>
</section>

{% schema %}
{
  "name": "AB: As seen on you",
  "tag": "div",
  "class": "ab-ugc-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As seen on you"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Share your look with <strong>@africasbesthaircare</strong>"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Vertical 9:16, under 30 seconds. Plays muted when the visitor taps play."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image",
          "info": "Shown before the video plays, or on its own without a video. Vertical 9:16, at least 540 x 960px."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Poster description (alt text)",
          "default": "Customer showing their hair"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Tagged product"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Video description for screen readers",
          "info": "Defaults to the tagged product's name."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB: As seen on you",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
