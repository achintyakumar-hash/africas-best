{%- comment -%}
  Shop by Concern (FINAL / Homepage section 2).
  Desktop: 3 tiles in a row, 560px tall, 12px radius, label bottom-left and VIEW
  (outline on image) bottom-right. Hovering a tile fills its VIEW button.
  Tablet: 3 tiles in a row, 340px tall. Mobile: swipe carousel of 260 x 340 tiles,
  VIEW (36px) under the label, dots below.
{%- endcomment -%}

<section class="ab-scope ab-concern ab-section ab-bg--{{ section.settings.background }}">
  <div class="ab-container">
    {%- if section.settings.heading != blank -%}
      <div class="ab-section-header ab-section-header--center">
        <h2 class="ab-section-heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <ab-carousel class="ab-concern__carousel" data-label="{{ section.settings.heading | escape }}">
      <ul class="ab-carousel__track" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            case forloop.index
              when 1
                assign fallback_key = 'lifestyle-1'
                assign fallback_position = 'center'
              when 2
                assign fallback_key = 'lifestyle-3'
                assign fallback_position = 'center'
              else
                assign fallback_key = 'lifestyle-2'
                assign fallback_position = '72% center'
            endcase
            capture fallback_url
              render 'ab-fallback-url', key: fallback_key
            endcapture
            assign tile_position = block.settings.image.presentation.focal_point | default: fallback_position
            assign tile_url = block.settings.link | default: '/collections/all'
          -%}
          <li class="ab-carousel__slide" {{ block.shopify_attributes }}>
            <a href="{{ tile_url }}" class="ab-concern__tile{% if block.settings.image == blank and forloop.first %} ab-concern__tile--brighten{% endif %}" style="--ab-tile-position: {{ tile_position }};">
              {%- render 'ab-image',
                image: block.settings.image,
                fallback: fallback_url,
                alt: '',
                widths: '300, 450, 600, 900',
                sizes: '(min-width: 1024px) 420px, (min-width: 768px) 33vw, 260px',
                class: 'ab-concern__image',
                width: 1024,
                height: 1024
              -%}
              <span class="ab-concern__overlay" aria-hidden="true"></span>
              <span class="ab-concern__content">
                <span class="ab-concern__label">{{ block.settings.label }}</span>
                <span class="ab-btn ab-btn--on-image ab-concern__view" aria-hidden="true">
                  {{- block.settings.button_label | default: 'View' -}}
                </span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- render 'ab-carousel-controls', arrows: false -%}
    </ab-carousel>
  </div>
</section>

{% schema %}
{
  "name": "AB: Shop by concern",
  "tag": "div",
  "class": "ab-concern-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by concern"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Portrait, at least 900 x 1200px. All tiles get the same light mint wash and bottom gradient."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Hair growth"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "View"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB: Shop by concern",
      "blocks": [
        { "type": "tile", "settings": { "label": "Hair growth" } },
        { "type": "tile", "settings": { "label": "Deep moisture" } },
        { "type": "tile", "settings": { "label": "Scalp care" } }
      ]
    }
  ]
}
{% endschema %}
