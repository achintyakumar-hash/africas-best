{%- comment -%}
  Best Sellers (FINAL / Homepage section 3). Also usable as "Our Best Sellers" on other pages.
  Desktop: centered heading, 4 product cards with arrows outside the content column,
  VIEW ALL text link below. Mobile/tablet: swipe carousel of 169px (200px tablet) cards,
  dots 16px below, VIEW ALL 16px below the dots.
  Collection: the picked collection, else the "best-sellers" collection, else all products.
{%- endcomment -%}

{{ 'ab-product-card.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'ab-best-sellers.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'ab-carousel.js' | asset_url }}" type="module"></script>

{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections['best-sellers']
  endif
  if source == blank or source.products_count == 0
    assign source = collections.all
  endif

  assign view_all_url = section.settings.view_all_link | default: source.url
-%}

<section class="ab-scope ab-best-sellers ab-section ab-bg--{{ section.settings.background }}">
  <div class="ab-container">
    {%- if section.settings.heading != blank -%}
      <div class="ab-section-header ab-section-header--center">
        <h2 class="ab-section-heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <ab-carousel
      class="ab-carousel--products ab-best-sellers__carousel"
      data-label="{{ section.settings.heading | escape }}"
    >
      <ul class="ab-carousel__track" role="list">
        {%- for product in source.products limit: section.settings.limit -%}
          <li class="ab-carousel__slide">{% render 'ab-product-card', product: product %}</li>
        {%- else -%}
          <li class="ab-carousel__slide"><p>Add products to the "{{ source.title }}" collection.</p></li>
        {%- endfor -%}
      </ul>
      {%- render 'ab-carousel-controls', label: 'products' -%}
    </ab-carousel>

    {%- if section.settings.view_all_label != blank -%}
      <div class="ab-best-sellers__footer">
        {%- render 'ab-button', label: section.settings.view_all_label, url: view_all_url, style: 'link' -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AB: Best sellers",
  "tag": "div",
  "class": "ab-best-sellers-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Defaults to the collection with the handle best-sellers."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link",
      "info": "Defaults to the collection page."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "white"
    }
  ],
  "presets": [
    {
      "name": "AB: Best sellers"
    }
  ]
}
{% endschema %}
