{%- comment -%}
  Reviews: "What our customers say" (FINAL / Homepage section 8).
  Desktop: white section. Left column (320px): heading + circular outline arrow buttons.
  Right: 2 cream review cards visible. Each card has the reviewer photo on the left, then stars,
  the quote, name + source, and the product as an underlined link.
  Mobile/tablet: centered heading, swipe carousel of 300 x 200 cream cards (48px round photo,
  stars and name in the top row, 3-line quote, product link), dots below.
  Review content is entered as blocks, so it can come from any review source.
  An empty product picker falls back to the best-sellers collection, then all products.
{%- endcomment -%}

{{ 'ab-reviews.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'ab-carousel.js' | asset_url }}" type="module"></script>

{%- liquid
  assign link_source = collections['best-sellers']
  if link_source == blank or link_source.products_count == 0
    assign link_source = collections.all
  endif
  assign heading_id = 'AbReviewsHeading-' | append: section.id
-%}

{%- comment -%} The carousel inside is the labelled region, so the section itself isn't a second landmark. {%- endcomment -%}
<section class="ab-scope ab-reviews ab-section ab-bg--{{ section.settings.background }}">
  <div class="ab-container">
    <ab-carousel class="ab-reviews__carousel" data-label="{{ section.settings.heading | escape }}">
      <div class="ab-reviews__layout">
        <div class="ab-reviews__intro">
          <h2 id="{{ heading_id }}" class="ab-section-heading ab-reviews__heading">{{ section.settings.heading }}</h2>
          <div class="ab-reviews__arrows">
            <button type="button" class="ab-arrow ab-arrow--outline" data-ab-prev aria-label="Previous reviews">
              {%- render 'ab-icon', name: 'chevron-left' -%}
            </button>
            <button type="button" class="ab-arrow ab-arrow--outline" data-ab-next aria-label="Next reviews">
              {%- render 'ab-icon', name: 'chevron-right' -%}
            </button>
          </div>
        </div>

        <div class="ab-reviews__viewport">
          <ul class="ab-carousel__track ab-reviews__track" role="list">
            {%- for block in section.blocks -%}
              {%- liquid
                assign review_product = block.settings.product
                if review_product == blank
                  assign review_product = link_source.products[forloop.index0]
                endif
                if review_product == blank
                  assign review_product = collections.all.products[forloop.index0]
                endif
                assign review_mod = forloop.index0 | modulo: 4
                case review_mod
                  when 0
                    assign fallback_key = 'lifestyle-3'
                    assign fallback_position = '30% center'
                  when 1
                    assign fallback_key = 'lifestyle-4'
                    assign fallback_position = 'center'
                  when 2
                    assign fallback_key = 'lifestyle-1'
                    assign fallback_position = '40% center'
                  else
                    assign fallback_key = 'lifestyle-2'
                    assign fallback_position = '68% center'
                endcase
                capture fallback_url
                  render 'ab-fallback-url', key: fallback_key
                endcapture
                assign photo_position = block.settings.image.presentation.focal_point | default: fallback_position
              -%}
              <li class="ab-carousel__slide ab-reviews__slide" {{ block.shopify_attributes }}>
                <figure class="ab-review" style="--ab-review-position: {{ photo_position }};">
                  <div class="ab-review__photo">
                    {%- render 'ab-image',
                      image: block.settings.image,
                      fallback: fallback_url,
                      alt: '',
                      widths: '96, 140, 280',
                      sizes: '(min-width: 1024px) 140px, 48px',
                      class: 'ab-review__image',
                      width: 1024,
                      height: 1024
                    -%}
                  </div>
                  <div class="ab-review__stars">
                    {%- render 'ab-stars', rating: block.settings.rating -%}
                  </div>
                  <blockquote class="ab-review__quote">
                    <p>“{{ block.settings.quote }}”</p>
                  </blockquote>
                  <figcaption class="ab-review__who">
                    <span class="ab-review__name">{{ block.settings.title }}</span>
                    {%- if block.settings.source != blank -%}
                      <span class="ab-review__source">Verified review on {{ block.settings.source }}</span>
                    {%- endif -%}
                  </figcaption>
                  {%- if review_product != blank -%}
                    <a href="{{ review_product.url }}" class="ab-review__product">{{ review_product.title }}</a>
                  {%- endif -%}
                </figure>
              </li>
            {%- endfor -%}
          </ul>
          <div class="ab-carousel__dots" data-ab-dots></div>
        </div>
      </div>
    </ab-carousel>
  </div>
</section>

{% schema %}
{
  "name": "AB: Reviews",
  "tag": "div",
  "class": "ab-reviews-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Reviewer photo",
          "info": "Portrait, at least 280 x 360px. Only use photos you have permission to show. Until one is uploaded, a placeholder photo from the design is shown."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 0.5,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "Keep it to about 3 lines (120 characters) so it fits the mobile card.",
          "default": "My hair has never felt this soft. I've used Africa's Best for years and it still works every time."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Reviewer name",
          "default": "Danielle M."
        },
        {
          "type": "text",
          "id": "source",
          "label": "Source",
          "info": "Shown as \"Verified review on …\".",
          "default": "Walmart"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Reviewed product",
          "info": "Leave empty to use the best-sellers collection's products in order."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB: Reviews",
      "blocks": [
        { "type": "review" },
        {
          "type": "review",
          "settings": {
            "quote": "Light, not greasy, and my edges are thriving. I keep a bottle in every bag.",
            "title": "Monique R.",
            "source": "Amazon"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "A staple in my routine for years now. My curls have never looked this healthy.",
            "title": "Keisha W.",
            "source": "Target"
          }
        }
      ]
    }
  ]
}
{% endschema %}
