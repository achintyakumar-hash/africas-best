{%- comment -%}
  Quality Ingredients (FINAL / Homepage section 5).
  Desktop: centered heading and text (720px), then one row of round ingredient photos (120px)
  between thin dividers, with uppercase labels.
  Mobile: 64px circles, 4 per row with the last row centered, 11px labels (2 lines reserved).
  A missing photo falls back to the design's stock photo when the label matches a known
  ingredient (Olive Oil, Shea Butter, Honey, Castor Oil, Egg Protein, Aloe, Clove).
{%- endcomment -%}

<section class="ab-scope ab-ingredients ab-section ab-bg--{{ section.settings.background }}">
  <div class="ab-container ab-ingredients__inner">
    <div class="ab-ingredients__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="ab-section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="ab-ingredients__text ab-rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="ab-ingredients__list" role="list" style="--ab-ingredient-count: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign ingredient_key = block.settings.label | handleize
            capture fallback_url
              render 'ab-fallback-url', key: ingredient_key
            endcapture
          -%}
          <li class="ab-ingredients__item" {{ block.shopify_attributes }}>
            <span class="ab-ingredients__photo">
              {%- render 'ab-image',
                image: block.settings.image,
                fallback: fallback_url,
                alt: '',
                widths: '120, 240, 360',
                sizes: '(min-width: 1024px) 120px, 64px',
                class: 'ab-ingredients__image',
                width: 600,
                height: 600
              -%}
            </span>
            <span class="ab-ingredients__label">{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      {%- render 'ab-button',
        label: section.settings.button_label,
        url: section.settings.button_link,
        style: 'secondary',
        class: 'ab-ingredients__button'
      -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AB: Quality ingredients",
  "tag": "div",
  "class": "ab-ingredients-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quality ingredients. Healthier hair."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>For over 20 years, Africa's Best has made moisturizing, nourishing hair care with natural ingredients like olive oil, shea butter, honey, castor oil, egg protein, aloe and clove.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Optional. The final design has no button here."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Square close-up, at least 360 x 360px. Shown as a circle."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Olive Oil"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB: Quality ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "label": "Olive Oil" } },
        { "type": "ingredient", "settings": { "label": "Shea Butter" } },
        { "type": "ingredient", "settings": { "label": "Honey" } },
        { "type": "ingredient", "settings": { "label": "Castor Oil" } },
        { "type": "ingredient", "settings": { "label": "Egg Protein" } },
        { "type": "ingredient", "settings": { "label": "Aloe" } },
        { "type": "ingredient", "settings": { "label": "Clove" } }
      ]
    }
  ]
}
{% endschema %}
