{%- comment -%}
  Moisture That Lasts: numbered product spotlight (FINAL / Homepage section 6).
  Desktop: two columns. Left, a 680px photo (12px radius) with white numbered markers placed by
  each product block's X/Y position. Right, eyebrow, heading and a numbered list of product rows
  (number, thumbnail, name, arrow) linking to the product page. Hover turns name and arrow #B4532A.
  Mobile/tablet: photo first (420px / 520px tall, inside the side padding), then eyebrow, heading
  and 64px rows.
  An empty product picker falls back to the olive-oil-conditioning collection, then all products.
{%- endcomment -%}

{%- liquid
  assign fallback_source = collections['olive-oil-conditioning']
  if fallback_source == blank or fallback_source.products_count == 0
    assign fallback_source = collections.all
  endif
  capture fallback_url
    render 'ab-fallback-url', key: 'lifestyle-4'
  endcapture
  assign photo_position = section.settings.image.presentation.focal_point | default: 'center 30%'
  assign heading_id = 'AbSpotlightHeading-' | append: section.id
-%}

<section
  class="ab-scope ab-spotlight ab-section ab-bg--{{ section.settings.background }}"
  aria-labelledby="{{ heading_id }}"
>
  <div class="ab-container ab-spotlight__inner">
    <div class="ab-spotlight__media" style="--ab-spotlight-position: {{ photo_position }};">
      {%- render 'ab-image',
        image: section.settings.image,
        fallback: fallback_url,
        alt: section.settings.image_alt,
        widths: '400, 600, 800, 1000, 1280',
        sizes: '(min-width: 1024px) 600px, 100vw',
        class: 'ab-spotlight__image',
        width: 1024,
        height: 1024
      -%}
      {%- for block in section.blocks -%}
        <span
          class="ab-spotlight__marker"
          style="--ab-marker-x: {{ block.settings.marker_x }}%; --ab-marker-y: {{ block.settings.marker_y }}%; --ab-marker-x-mobile: {{ block.settings.marker_x_mobile }}%; --ab-marker-y-mobile: {{ block.settings.marker_y_mobile }}%;"
          aria-hidden="true"
        >
          {{- forloop.index -}}
        </span>
      {%- endfor -%}
    </div>

    <div class="ab-spotlight__content">
      <div class="ab-spotlight__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ab-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 id="{{ heading_id }}" class="ab-section-heading ab-spotlight__heading">{{ section.settings.heading }}</h2>
      </div>

      <ol class="ab-spotlight__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign spot_product = block.settings.product
            if spot_product == blank
              assign spot_product = fallback_source.products[forloop.index0]
            endif
            if spot_product == blank
              assign spot_product = collections.all.products[forloop.index0]
            endif
            assign spot_title = block.settings.title | default: spot_product.title
          -%}
          {%- if spot_product != blank or spot_title != blank -%}
            <li {{ block.shopify_attributes }}>
              <a href="{{ spot_product.url | default: '/collections/all' }}" class="ab-spotlight__row">
                <span class="ab-spotlight__number" aria-hidden="true">{{ forloop.index }}</span>
                <span class="ab-spotlight__thumb">
                  {%- if spot_product.featured_media -%}
                    {{
                      spot_product.featured_media.preview_image
                      | image_url: width: 160
                      | image_tag: widths: '80, 160', sizes: '(min-width: 1024px) 64px, 36px', loading: 'lazy', alt: ''
                    }}
                  {%- endif -%}
                </span>
                <span class="ab-spotlight__name">
                  <span class="ab-visually-hidden">{{ forloop.index }}. </span>
                  {{- spot_title -}}
                </span>
                <span class="ab-spotlight__arrow" aria-hidden="true">
                  {%- render 'ab-icon', name: 'arrow-forward' -%}
                </span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AB: Product spotlight",
  "tag": "div",
  "class": "ab-spotlight-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "A person holding the products, at least 1200 x 1360px. Place the numbered markers on the products with each product's X/Y settings."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo description (alt text)",
      "default": "Woman holding Olive Oil Conditioning products"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Olive oil conditioning"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Moisture that lasts"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name override",
          "info": "Defaults to the product title."
        },
        {
          "type": "header",
          "content": "Numbered marker on the photo"
        },
        {
          "type": "paragraph",
          "content": "Move the marker onto this product in the photo. 0% is the left/top edge of the photo, 95% the right/bottom edge. Mobile shows a taller crop, so it has its own position."
        },
        {
          "type": "range",
          "id": "marker_x",
          "label": "Desktop: from left",
          "min": 0,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 22
        },
        {
          "type": "range",
          "id": "marker_y",
          "label": "Desktop: from top",
          "min": 0,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 58
        },
        {
          "type": "range",
          "id": "marker_x_mobile",
          "label": "Mobile and tablet: from left",
          "min": 0,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 30
        },
        {
          "type": "range",
          "id": "marker_y_mobile",
          "label": "Mobile and tablet: from top",
          "min": 0,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 52
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB: Product spotlight",
      "blocks": [
        { "type": "product", "settings": { "marker_x": 22, "marker_y": 58, "marker_x_mobile": 30, "marker_y_mobile": 52 } },
        { "type": "product", "settings": { "marker_x": 48, "marker_y": 66, "marker_x_mobile": 54, "marker_y_mobile": 60 } },
        { "type": "product", "settings": { "marker_x": 70, "marker_y": 54, "marker_x_mobile": 70, "marker_y_mobile": 46 } }
      ]
    }
  ]
}
{% endschema %}
