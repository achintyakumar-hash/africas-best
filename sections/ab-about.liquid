{%- comment -%}
  About Us split banner (FINAL / Homepage section 9).
  Desktop: two full-bleed halves, 480px tall. Left: photo under a dark overlay with a large white
  heading, text and an outline-on-image button. Right: a second photo, no text.
  Mobile/tablet: one 480px photo with the overlay and the text at the bottom, full-width button.
  The second photo is hidden.
{%- endcomment -%}

{{ 'ab-about.css' | asset_url | stylesheet_tag: preload: true }}

{%- liquid
  capture fallback_left
    render 'ab-fallback-url', key: 'lifestyle-1'
  endcapture
  capture fallback_right
    render 'ab-fallback-url', key: 'lifestyle-3'
  endcapture
  assign left_position = section.settings.image.presentation.focal_point | default: '40% center'
  assign right_position = section.settings.image_secondary.presentation.focal_point | default: 'center 30%'
  assign heading_id = 'AbAboutHeading-' | append: section.id
-%}

<section class="ab-scope ab-about ab-on-dark" aria-labelledby="{{ heading_id }}">
  <div class="ab-about__panel" style="--ab-about-position: {{ left_position }}; --ab-about-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
    {%- render 'ab-image',
      image: section.settings.image,
      fallback: fallback_left,
      alt: '',
      widths: '400, 600, 800, 1000, 1440',
      sizes: '(min-width: 1024px) 50vw, 100vw',
      class: 'ab-about__image',
      width: 1024,
      height: 1024
    -%}
    <div class="ab-about__overlay" aria-hidden="true"></div>
    <div class="ab-about__content">
      <h2 id="{{ heading_id }}" class="ab-about__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="ab-about__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        {%- assign about_url = section.settings.button_link | default: '/pages/about-us' -%}
        {%- render 'ab-button',
          label: section.settings.button_label,
          url: about_url,
          style: 'on-image',
          full_width_mobile: true
        -%}
      {%- endif -%}
    </div>
  </div>
  <div class="ab-about__secondary" style="--ab-about-position: {{ right_position }};" aria-hidden="true">
    {%- render 'ab-image',
      image: section.settings.image_secondary,
      fallback: fallback_right,
      alt: '',
      widths: '600, 800, 1000, 1440',
      sizes: '50vw',
      class: 'ab-about__image',
      width: 1024,
      height: 1024
    -%}
  </div>
</section>

{% schema %}
{
  "name": "AB: About us banner",
  "tag": "div",
  "class": "ab-about-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo behind the text",
      "info": "At least 1440 x 960px. Until one is uploaded, a placeholder photo from the design is shown."
    },
    {
      "type": "image_picker",
      "id": "image_secondary",
      "label": "Second photo",
      "info": "Desktop only. At least 1440 x 960px. Until one is uploaded, a placeholder photo from the design is shown."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "info": "Darkens the photo so the white text stays readable (minimum 55%).",
      "min": 55,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 62
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About us"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "For over 20 years, Africa's Best has created moisturizing, nourishing hair care for every hair type and texture."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to /pages/about-us."
    }
  ],
  "presets": [
    {
      "name": "AB: About us banner"
    }
  ]
}
{% endschema %}
